<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="297dp"
        android:src="@drawable/logo" />

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="USTA Brokers"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnProperty1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="123 River Rd - San Antonio - TX"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnProperty2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="23412 Hill St - San Antonio - TX"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnProperty3"
        android:layout_width="253dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="34 Deer Ct - San Antonio - TX" />

    <Button
        android:id="@+id/btnProperty4"
        android:layout_width="252dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="109 Medina St - Boerne - TX" />
</LinearLayout>
